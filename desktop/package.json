{
  "name": "studio-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Studi'OS Desktop - Tauri 2 shell with the supervised Studio OS daemon.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "prereqs": "node scripts/check-prereqs.mjs",
    "config": "node scripts/make-config.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build": "node scripts/build.mjs",
    "build:with-sidecar": "node scripts/build.mjs --sidecar",
    "package": "node scripts/build.mjs --installer",
    "version:check": "node scripts/version.mjs --check",
    "version:sync": "node scripts/version.mjs --sync",
    "notes:check": "node scripts/release-notes.mjs --check",
    "notes:write": "node scripts/release-notes.mjs --write",
    "dev": "node scripts/dev.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:build-policy": "node --test scripts/build-policy.test.mjs",
    "test:signing": "node --test scripts/windows-signing.test.mjs",
    "test:release-artifacts": "node --test scripts/release-artifacts.test.mjs",
    "test:update-manifest": "node --test scripts/update-manifest.test.mjs",
    "test:promote": "node --test scripts/promote-channel.test.mjs",
    "test:production-gate": "node --test scripts/production-gate.test.mjs",
    "test:release-notes": "node --test scripts/release-notes.test.mjs",
    "test:version": "node --test scripts/version.test.mjs",
    "test:scripts": "node --test scripts/build-policy.test.mjs scripts/windows-signing.test.mjs scripts/release-artifacts.test.mjs scripts/update-manifest.test.mjs scripts/version.test.mjs scripts/promote-channel.test.mjs scripts/production-gate.test.mjs scripts/stage-dev-server.test.mjs scripts/release-notes.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:shell": "node scripts/e2e-shell.mjs",
    "test:install": "node scripts/install-test.mjs",
    "notices": "node scripts/notices.mjs --check",
    "gate": "node scripts/build.mjs --sidecar && node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "playwright-core": "^1.63.0"
  }
}
