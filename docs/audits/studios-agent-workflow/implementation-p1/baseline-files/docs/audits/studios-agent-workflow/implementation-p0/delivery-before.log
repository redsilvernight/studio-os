        )
        assert successor["session"]["id"] != session_id
        new_id = successor["session"]["id"]
        expected = [] if mode == "acked" else ids[-1:] if mode == "late" else ids
        contents: dict[str, str] = {}
        order: list[str] = []
        effects: set[str] = set()
        for _ in range(20):
