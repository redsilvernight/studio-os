{
  "$defs": {
    "SkillResolution": {
      "additionalProperties": false,
      "properties": {
        "choice": {
          "enum": [
            "local",
            "library"
          ],
          "title": "Choice",
          "type": "string"
        },
        "preview_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Preview Hash",
          "type": "string"
        },
        "stable_key": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,199}$",
          "title": "Stable Key",
          "type": "string"
        }
      },
      "required": [
        "stable_key",
        "choice",
        "preview_hash"
      ],
      "title": "SkillResolution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Apply the skill synchronization plan. Requires explicit confirmation.",
  "properties": {
    "confirm": {
      "default": false,
      "title": "Confirm",
      "type": "boolean"
    },
    "overwrite": {
      "default": false,
      "title": "Overwrite",
      "type": "boolean"
    },
    "resolutions": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SkillResolution"
          },
          "maxItems": 500,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolutions"
    }
  },
  "title": "SkillsApplyRequest",
  "type": "object"
}
