{
  "additionalProperties": false,
  "description": "Apply is bound to a previously previewed plan by id and hash, and needs\nan explicit confirmation: nothing is applied from a fresh request.",
  "properties": {
    "confirmed": {
      "const": true,
      "title": "Confirmed",
      "type": "boolean"
    },
    "plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,200}$",
      "title": "Plan Id",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "plan_hash",
    "confirmed"
  ],
  "title": "HarnessApplyRequest",
  "type": "object"
}
