{
  "$defs": {
    "RepoRoot": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "title": "RepoRoot",
      "type": "object"
    },
    "WorkspaceRoots": {
      "additionalProperties": false,
      "properties": {
        "repo_roots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RepoRoot"
          },
          "maxItems": 32,
          "title": "Repo Roots",
          "type": "array"
        },
        "workspace_root": {
          "title": "Workspace Root",
          "type": "string"
        }
      },
      "required": [
        "workspace_root"
      ],
      "title": "WorkspaceRoots",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Ask the daemon to bind a user-confirmed folder pick to a single-use\n`root_confirmation_id`.\n\nThe shell shows the native folder dialog and forwards the confirmed roots;\nthe daemon only binds roots it can read, then `workspace.save_config`\nconsumes the id. The request carries roots only — no identity, no secret —\nand the id stays bound to the fingerprint of these exact roots, single-use\nwith a short TTL (see `RootConfirmationService`).",
  "properties": {
    "roots": {
      "$ref": "#/$defs/WorkspaceRoots"
    }
  },
  "required": [
    "roots"
  ],
  "title": "WorkspaceConfirmRootsRequest",
  "type": "object"
}
