{
  "$defs": {
    "SkillSyncStatusState": {
      "enum": [
        "in_progress",
        "up_to_date",
        "updated",
        "conflicts",
        "not_synced",
        "disabled"
      ],
      "title": "SkillSyncStatusState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Persistent status of the last skill synchronization.",
  "properties": {
    "added": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "title": "Added",
      "type": "array"
    },
    "auto_sync_enabled": {
      "title": "Auto Sync Enabled",
      "type": "boolean"
    },
    "conflicts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "title": "Conflicts",
      "type": "array"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "last_check": {
      "format": "date-time",
      "title": "Last Check",
      "type": "string"
    },
    "last_successful_sync": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Successful Sync"
    },
    "state": {
      "$ref": "#/$defs/SkillSyncStatusState"
    },
    "updated": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "title": "Updated",
      "type": "array"
    }
  },
  "required": [
    "state",
    "last_check",
    "auto_sync_enabled"
  ],
  "title": "SkillsSyncStatus",
  "type": "object"
}
