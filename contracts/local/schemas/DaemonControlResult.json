{
  "$defs": {
    "ComponentId": {
      "enum": [
        "desktop",
        "bridge",
        "daemon",
        "workspace",
        "knowledge",
        "code_graph",
        "harness",
        "secret_store",
        "watcher"
      ],
      "title": "ComponentId",
      "type": "string"
    },
    "CrashInfo": {
      "additionalProperties": false,
      "properties": {
        "crashed_at": {
          "format": "date-time",
          "title": "Crashed At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "recoveries_attempted": {
          "maximum": 100,
          "minimum": 0,
          "title": "Recoveries Attempted",
          "type": "integer"
        }
      },
      "required": [
        "crashed_at",
        "recoveries_attempted"
      ],
      "title": "CrashInfo",
      "type": "object"
    },
    "DaemonAction": {
      "enum": [
        "attach",
        "start",
        "stop",
        "status",
        "restart"
      ],
      "title": "DaemonAction",
      "type": "string"
    },
    "DaemonControlOutcome": {
      "enum": [
        "ok",
        "already_running",
        "not_running",
        "unavailable",
        "recovering",
        "incompatible",
        "identity_mismatch",
        "failed"
      ],
      "title": "DaemonControlOutcome",
      "type": "string"
    },
    "DaemonInstanceRef": {
      "additionalProperties": false,
      "properties": {
        "daemon_version": {
          "maxLength": 64,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Daemon Version",
          "type": "string"
        },
        "instance_id": {
          "format": "uuid",
          "title": "Instance Id",
          "type": "string"
        },
        "lock_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lock Key",
          "type": "string"
        },
        "ownership": {
          "$ref": "#/$defs/DaemonOwnership"
        },
        "pid": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pid"
        },
        "profile": {
          "$ref": "#/$defs/ProfileRef"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "profile",
        "lock_key",
        "ownership",
        "daemon_version",
        "started_at"
      ],
      "title": "DaemonInstanceRef",
      "type": "object"
    },
    "DaemonOwnership": {
      "enum": [
        "desktop_started",
        "external"
      ],
      "title": "DaemonOwnership",
      "type": "string"
    },
    "DaemonRunState": {
      "enum": [
        "stopped",
        "starting",
        "running",
        "stopping",
        "recovering",
        "crashed",
        "unavailable",
        "incompatible"
      ],
      "title": "DaemonRunState",
      "type": "string"
    },
    "DaemonStatus": {
      "additionalProperties": false,
      "properties": {
        "instance": {
          "anyOf": [
            {
              "$ref": "#/$defs/DaemonInstanceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_crash": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrashInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "negotiated": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProtocolVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutboxSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "$ref": "#/$defs/DaemonRunState"
        }
      },
      "required": [
        "state"
      ],
      "title": "DaemonStatus",
      "type": "object"
    },
    "IdentityBinding": {
      "additionalProperties": false,
      "description": "The identity a piece of queued local work was created under. An outbox\nentry replays only under an identical binding.",
      "properties": {
        "machine_id": {
          "format": "uuid",
          "title": "Machine Id",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Profile Id",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "server_origin": {
          "title": "Server Origin",
          "type": "string"
        },
        "workspace_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        }
      },
      "required": [
        "server_origin",
        "profile_id",
        "machine_id"
      ],
      "title": "IdentityBinding",
      "type": "object"
    },
    "LocalError": {
      "additionalProperties": false,
      "description": "The one structured error shape of the local stack. Never carries a\nsecret, a stack trace or an absolute local path: `message` and `details`\nare validated, bounded and safe to display or log.",
      "properties": {
        "code": {
          "$ref": "#/$defs/LocalErrorCode"
        },
        "component": {
          "$ref": "#/$defs/ComponentId"
        },
        "correlation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "component",
        "retryable"
      ],
      "title": "LocalError",
      "type": "object"
    },
    "LocalErrorCode": {
      "description": "Closed, deliberately small taxonomy. Codes describe what the caller can\nbranch on; the human message and bounded details carry the rest.",
      "enum": [
        "invalid_request",
        "unknown_command",
        "payload_too_large",
        "protocol_incompatible",
        "capability_missing",
        "not_supported",
        "cancelled",
        "timeout",
        "internal_error",
        "daemon_unavailable",
        "daemon_already_running",
        "daemon_crashed",
        "identity_mismatch",
        "wrong_profile",
        "secret_absent",
        "secret_inaccessible",
        "secret_revoked",
        "keyring_unavailable",
        "workspace_config_missing",
        "workspace_config_invalid",
        "workspace_moved",
        "workspace_inaccessible",
        "project_unavailable",
        "feature_disabled",
        "provider_not_installed",
        "provider_incompatible",
        "permission_denied",
        "index_absent",
        "index_corrupt",
        "language_unsupported",
        "plan_expired"
      ],
      "title": "LocalErrorCode",
      "type": "string"
    },
    "OutboxSummary": {
      "additionalProperties": false,
      "description": "What the daemon exposes about its queue. `binding` is the identity the\nqueued entries were created under; replay is refused when it does not match\nthe active identity.",
      "properties": {
        "binding": {
          "$ref": "#/$defs/IdentityBinding"
        },
        "blocked_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "oldest_pending_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oldest Pending At"
        },
        "partition_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Partition Key",
          "type": "string"
        },
        "pending_count": {
          "minimum": 0,
          "title": "Pending Count",
          "type": "integer"
        },
        "replay_blocked": {
          "default": false,
          "title": "Replay Blocked",
          "type": "boolean"
        }
      },
      "required": [
        "binding",
        "partition_key",
        "pending_count"
      ],
      "title": "OutboxSummary",
      "type": "object"
    },
    "ProfileRef": {
      "additionalProperties": false,
      "description": "A local profile is one server origin on one machine. Two profiles never\nshare a secret, an outbox partition or a daemon instance.",
      "properties": {
        "profile_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Profile Id",
          "type": "string"
        },
        "server_origin": {
          "title": "Server Origin",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "server_origin"
      ],
      "title": "ProfileRef",
      "type": "object"
    },
    "ProtocolVersion": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "maximum": 999,
          "minimum": 1,
          "title": "Major",
          "type": "integer"
        },
        "minor": {
          "maximum": 999,
          "minimum": 0,
          "title": "Minor",
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "title": "ProtocolVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/DaemonAction"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "$ref": "#/$defs/DaemonControlOutcome"
    },
    "status": {
      "$ref": "#/$defs/DaemonStatus"
    }
  },
  "required": [
    "action",
    "outcome",
    "status"
  ],
  "title": "DaemonControlResult",
  "type": "object"
}
