# Copy to docker/.env and override all secrets for production.

# Pin the compose project name so every `docker compose` in this directory
# targets the same stack (`studio-os-*`). Without it, compose derives the
# project from the directory name and a stray invocation creates a SECOND
# stack that reuses the same docker/.data bind mounts.
COMPOSE_PROJECT_NAME=studio-os

POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=studio

MINIO_ROOT_USER=studio
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_BUCKET=studio-transfers

API_DOMAIN=api.example.com
MCP_DOMAIN=mcp.example.com
STORAGE_DOMAIN=storage.example.com
DASHBOARD_DOMAIN=studio.example.com

# API settings (passed to the api/mcp containers)
STUDIO_JWT_SECRET=change-me-to-a-long-random-string-min-32-bytes
STUDIO_CORS_ORIGINS=https://studio.example.com
STUDIO_LOG_FORMAT=text
STUDIO_LOG_LEVEL=INFO
STUDIO_RATE_LIMIT_REQUESTS_PER_MINUTE=120
STUDIO_RATE_LIMIT_BURST=20

# Dashboard CSP (DEC-0061, Report-Only) : origines connect-src supplementaires
# (origine API si VITE_STUDIO_API_URL pointe cross-origin au build). Vide par
# defaut = deploiement prod same-origin + domaine storage.
DASHBOARD_CSP_CONNECT_EXTRA=

# URL publique du endpoint S3 (URLs pre-signees). Optionnelle en production :
# docker-compose.yml la derive de STORAGE_DOMAIN (https://$STORAGE_DOMAIN). Elle
# est lue par register-user.sh pour afficher l'URL de stockage, et est
# obligatoire dans le compose des deploiements interimaires sans DNS public
# (ex. http://<ip-tailscale>:9000 ; voir HUMAN/04_DEPLOIEMENT_OVH.md).
# STUDIO_S3_PUBLIC_ENDPOINT_URL=
