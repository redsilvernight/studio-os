# Edge security headers (DEC-0060, etape 9.3) : HSTS + baseline sur les
# sites termines en TLS par Caddy. Le catch-all :80 (Tailscale Funnel,
# HTTP clair) est volontairement exclu : HSTS sur HTTP est ignore par
# spec et n'apporterait rien.
{$API_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy api:8000
}

{$MCP_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy mcp:8100
}

# Dashboard SPA served by the nginx container. API calls to /api and
# /openapi.json are proxied to the API service so the SPA can use same-origin
# requests (DASH-0/1).
{$DASHBOARD_DOMAIN} {
	# SAMEORIGIN (et non DENY) : la SPA n'est pas concue pour etre iframée
	# cross-origin, mais on ne casse pas un usage same-origin legitime.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# CSP Report-Only (DEC-0061) : aucun enforcement tant que l'e2e Playwright
	# ne prouve pas les parcours principaux. `connect-src` couvre le domaine
	# storage (uploads directs pré-signés, DEC-0025) ; `{$DASHBOARD_CSP_CONNECT_EXTRA}`
	# (optionnel, vide par défaut) ajoute l'origine API quand
	# `VITE_STUDIO_API_URL` pointe cross-origin au build.
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://{$STORAGE_DOMAIN} {$DASHBOARD_CSP_CONNECT_EXTRA}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
	route /api/* {
		reverse_proxy api:8000
	}

	route /openapi.json {
		reverse_proxy api:8000
	}

	route /healthz {
		reverse_proxy api:8000
	}

	reverse_proxy dashboard:80
}

# Passthrough to MinIO's S3 API only — TLS termination, no buffering/parsing
# of file bytes. Distinct from "the API proxying files" which is forbidden
# (.claude/rules/storage-transfers.md): this is the S3-compatible endpoint
# itself, addressed directly by pre-signed URLs (DEC-0004, docs/DECISIONS.md).
{$STORAGE_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy minio:9000
}

# Catch-all for Tailscale Funnel / direct-IP access. Tailscale terminates TLS
# and forwards plain HTTP to localhost, so this site listens on port 80.
:80 {
	route /api/* {
		reverse_proxy api:8000
	}

	route /openapi.json {
		reverse_proxy api:8000
	}

	route /healthz {
		reverse_proxy api:8000
	}

	reverse_proxy dashboard:80
}
