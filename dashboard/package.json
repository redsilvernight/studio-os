{
  "name": "studio-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Studi'OS human dashboard (DASH-0/1) — read-only client of the canonical HTTP API + SSE.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openapi:export": "python scripts/export_openapi.py",
    "openapi:types": "openapi-typescript openapi.json -o src/openapi-schema.ts",
    "openapi": "npm run openapi:export && npm run openapi:types"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
