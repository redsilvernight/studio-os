{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/graphify-studio.ps1 hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/graphify-studio.ps1 hook-guard read"
          }
        ]
      }
    ]
  }
}