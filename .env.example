# Copy to .env (gitignored) and fill in real values before `docker compose up`.
# Never commit real secrets here — this file only carries placeholders.

# Caddy — public domains (automatic HTTPS)
API_DOMAIN=api.example.com
MCP_DOMAIN=mcp.example.com
STORAGE_DOMAIN=storage.example.com

# PostgreSQL (internal only — no published port, see docker/docker-compose.yml)
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=studio

# MinIO (internal only — the S3 API is reachable solely through
# https://${STORAGE_DOMAIN} via Caddy, see docker/Caddyfile)
MINIO_ROOT_USER=studio
MINIO_ROOT_PASSWORD=change-me-dev-only
MINIO_BUCKET=studio-transfers

# Public registration & account e-mails (A4, DEC-0109). Registration stays
# false on any exposed instance until the C4 gate. Password recovery works as
# soon as an e-mail backend is configured. SMTP secrets live only in the real
# .env (gitignored), never here.
STUDIO_PUBLIC_REGISTRATION_ENABLED=false
# STUDIO_PUBLIC_BASE_URL=https://dashboard.example.com
STUDIO_EMAIL_BACKEND=disabled
# STUDIO_EMAIL_FROM=Studio OS <no-reply@example.com>
# STUDIO_SMTP_HOST=smtp.example.com
# STUDIO_SMTP_PORT=587
# STUDIO_SMTP_SECURITY=starttls
# STUDIO_SMTP_USERNAME=
# STUDIO_SMTP_PASSWORD=
